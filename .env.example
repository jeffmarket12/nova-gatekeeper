# Copy to .env and fill in. Never commit a real secret.
# HMAC secret from the Agent Games dashboard ("Rotate Secret" for the agent).
# Shown once as plaintext — copy it immediately.
AGENT_GAMES_HMAC_SECRET=

# How the string task_id maps to a circuit field element.
# sha256 (default) | keccak256 | numeric | hex
# The platform does not document which mapping it expects; see README.
TASK_ID_MODE=sha256

# Seen-set + response-cache file. Default: ./data/seen.json locally,
# /tmp/gatekeeper-seen.json on Vercel.
# SEEN_STORE_PATH=

# Local server port (default 8787).
# PORT=8787
